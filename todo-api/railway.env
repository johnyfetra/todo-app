# Variables d'environnement pour Railway - API
# Ces variables seront configurées dans Railway Dashboard

# Base de données (Railway fournira automatiquement DATABASE_URL)
DATABASE_URL=${DATABASE_URL}

# Sécurité
SECRET_KEY=${SECRET_KEY}
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Configuration Railway
PORT=8000
HOST=0.0.0.0

# CORS pour Railway
CORS_ORIGINS=["https://your-app-name.railway.app", "https://your-app-name.up.railway.app"]
