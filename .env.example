# --- API ---
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# DB
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=todo_password
POSTGRES_DB=todo_db
